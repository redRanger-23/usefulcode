JS
import { LightningElement, api } from 'lwc';
import { ShowToastEvent } from 'lightning/platformShowToastEvent';

export default class GoogleSpeechToText extends LightningElement {
    @api recordId;
    
    selectedMode = 'upload'; // 'upload' or 'live'
    transcription = '';
    isProcessing = false;
    
    modeOptions = [
        { label: 'Upload & Transcribe', value: 'upload' },
        { label: 'Live Transcription', value: 'live' }
    ];
    
    get isUploadMode() {
        return this.selectedMode === 'upload';
    }
    
    get isLiveMode() {
        return this.selectedMode === 'live';
    }
    
    handleModeChange(event) {
        this.selectedMode = event.detail.value;
        this.transcription = ''; // Clear transcription when switching modes
    }
    
    handleTranscriptionUpdate(event) {
        this.transcription = event.detail.transcription || '';
    }
    
    handleProcessingChange(event) {
        this.isProcessing = event.detail.isProcessing;
    }
    
    copyTranscription() {
        if (!this.transcription) {
            return;
        }
        
        // Copy to clipboard
        const textArea = document.createElement('textarea');
        textArea.value = this.transcription;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.select();
        
        try {
            document.execCommand('copy');
            this.showToast('Success', 'Transcription copied to clipboard', 'success');
        } catch (err) {
            this.showToast('Error', 'Failed to copy transcription', 'error');
        } finally {
            document.body.removeChild(textArea);
        }
    }
    
    showToast(title, message, variant) {
        const evt = new ShowToastEvent({
            title: title,
            message: message,
            variant: variant
        });
        this.dispatchEvent(evt);
    }
}

